    },
    {
      "source": "/contact",
      "headers": [
        { "key": "Link", "value": "<https://www.ledgerbandhu.com/contact>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/faq",
      "headers": [
        { "key": "Link", "value": "<https://www.ledgerbandhu.com/faq>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/privacy",
      "headers": [
        { "key": "Link", "value": "<https://www.ledgerbandhu.com/privacy>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/terms",
      "headers": [
        { "key": "Link", "value": "<https://www.ledgerbandhu.com/terms>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/daily-digest",
      "headers": [
        { "key": "Link", "value": "<https://www.ledgerbandhu.com/daily-digest>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/job-pdf",
      "headers": [
        { "key": "Link", "value": "<https://www.ledgerbandhu.com/job-pdf>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/register",
      "headers": [
